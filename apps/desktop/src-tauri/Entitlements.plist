<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droits de signature macOS (bundle.macOS.entitlements dans tauri.conf.json).
  Tauri signe l'app avec le « hardened runtime » (exigé pour la notarisation) : sans
  ces droits, macOS refuse l'accès à la caméra et au micro malgré les textes de
  src-tauri/Info.plist. Tauri signe aussi le moteur studiod (externalBin) en tant
  qu'exécutable, avec ces mêmes droits : c'est lui qui ouvre les périphériques.
  La capture d'écran ne demande pas de droit : elle s'autorise dans Réglages Système.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
