{
  "name": "@maya-studio/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Interface desktop de Maya Studio (Tauri 2 + React), qui parle au moteur uniquement en WebSocket.",
  "type": "module",
  "scripts": {
    "client": "npm run build --workspace @suite-media/client",
    "predev": "npm run client",
    "dev": "vite",
    "prebuild": "npm run client",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run client",
    "test": "vitest run",
    "sidecar": "node scripts/prepare-sidecar.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@suite-media/client": "0.1.0",
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
